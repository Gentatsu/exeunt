    "So it's already watching when you start your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So it's already watching when you start your Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So ist es schon aktiv, wenn du deinen Mac startest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainsi, il veille déjà quand vous démarrez votre Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así ya estará vigilando cuando enciendas el Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così è già in ascolto quando avvii il Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim ele já estará de olho quando você ligar o Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの起動時から、すでに見守ってくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 시작할 때 이미 지켜보고 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样开机时它就已经在守候了。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo let het al op zodra je je Mac start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki temu czuwa już po uruchomieniu Maca."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Böylece Mac’inizi başlattığınızda zaten gözetliyor olur."
          }
