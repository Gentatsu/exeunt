    "With the icon hidden, open Exeunt again from Launchpad or Spotlight to see these settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the icon hidden, open Exeunt again from Launchpad or Spotlight to see these settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das Symbol ausgeblendet, öffne Exeunt erneut über Launchpad oder Spotlight, um diese Einstellungen zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’icône est masquée, rouvrez Exeunt depuis le Launchpad ou Spotlight pour accéder à ces réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el icono oculto, vuelve a abrir Exeunt desde Launchpad o Spotlight para ver estos ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l’icona nascosta, riapri Exeunt da Launchpad o Spotlight per vedere queste impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o ícone oculto, abra o Exeunt de novo pelo Launchpad ou pelo Spotlight para ver estes ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンを非表示にした場合は、LaunchpadまたはSpotlightからExeuntをもう一度開くと、この設定を表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘을 숨긴 경우, Launchpad나 Spotlight에서 Exeunt를 다시 열면 이 설정을 볼 수 있습니다."
