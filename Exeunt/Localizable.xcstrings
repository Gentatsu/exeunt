    "Open TextEdit, close its window with the red button or Cmd+W, and watch it quit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open TextEdit, close its window with the red button or Cmd+W, and watch it quit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne TextEdit, schließe das Fenster mit dem roten Button oder ⌘W und sieh zu, wie es sich beendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez TextEdit, fermez sa fenêtre avec le bouton rouge ou ⌘W, et regardez-le quitter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre TextEdit, cierra su ventana con el botón rojo o con ⌘W y mira cómo se cierra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri TextEdit, chiudi la sua finestra con il pulsante rosso o con ⌘W e guardalo uscire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o TextEdit, feche a janela com o botão vermelho ou ⌘W e veja o app fechar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TextEditを開き、赤いボタンまたは⌘Wでウインドウを閉じると、Appが終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TextEdit을 열고 빨간 버튼이나 ⌘W로 윈도우를 닫으면 앱이 종료되는 것을 볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“文本编辑”，用红色按钮或 ⌘W 关闭它的窗口，看它自动退出。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open TextEdit, sluit het venster met de rode knop of ⌘W en zie de app stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz TextEdit, zamknij jego okno czerwonym przyciskiem lub ⌘W i patrz, jak się zamyka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TextEdit’i açın, penceresini kırmızı düğmeyle veya ⌘W ile kapatın ve çıkışını izleyin."
          }
        }
      }
    },
